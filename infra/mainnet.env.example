# Mainnet (Robinhood Chain 4663). Copy to a file OUTSIDE git, e.g. .env.mainnet, and fill in.
# Use brand-new keys. Never reuse testnet keys. Keep this file at permission 600.
CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_ID=4663
RPC_URL_MAINNET=
INDEXER_RPC_URL=
INDEXER_START_BLOCK=

# Separate Supabase project from testnet (tables have no chain_id column)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Role addresses (public) consumed by DeployMainnet.s.sol and the preflight
DEPLOYER_ADDRESS=
OPERATOR_ADDRESS=
KEEPER_ADDRESS=
ATTESTER_ADDRESS=
PAUSER_ADDRESS=
VALIDATOR_1_ADDRESS=
VALIDATOR_2_ADDRESS=
VALIDATOR_3_ADDRESS=

# Private keys (services only; the deployer key is used once, from your own machine)
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY_1=
VALIDATOR_PRIVATE_KEY_2=
VALIDATOR_PRIVATE_KEY_3=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=

# Canonical hash of config/nti.v1.json (printed by mainnet_preflight.py)
INITIAL_CONFIG_HASH=0x07acec1d77949027e6ba95a4ec7b43ce380fb70efd317e79d0f024e4afc8c297
ORACLE_GENESIS_TIMESTAMP=0
# Leave empty until the CA exists; then setNti(CA) + freeze()
NTI_TOKEN_ADDRESS=

RADAR_MIN_STAKE=
SIWE_SESSION_SECRET=
GRANT_ROUND_SECONDS=1209600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
MIMO_API_KEY=
X_ACCOUNTS_FILE=
