# Mainnet (Robinhood Chain 4663). Make it .env.mainnet on your own machine (outside git, mode 600).
#
# The same file does two jobs:
#   1. the deploy scripts read it from your machine (it holds the DEPLOYER key);
#   2. cutover_to_mainnet.py copies the service keys below into the VPS .env. The VPS keeps its own
#      Supabase, MiMo, Telegram and X settings; the deployer key is never copied there.
#
# Only the wallets are new. Supabase, the VPS, Vercel and the X accounts are the ones already running.

# --- Chain and RPC
CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_ID=4663
# One URL here (forge uses it). Alchemy's key works on mainnet, but its free tier serves eth_getLogs for only
# 10 blocks (~1 second): upgrade the key to pay-as-you-go for the indexer. On the VPS this may be a
# comma-separated fallback list: primary, then https://robinhood-rpc.publicnode.com for plain reads.
RPC_URL_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
INDEXER_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Printed by mainnet_wire.py after the deploy
INDEXER_START_BLOCK=
# 2000 needs a paid plan; the free tier needs 10 (and cannot keep up)
INDEXER_BATCH_BLOCKS=2000
INDEXER_POLL_MS=5000
DISCOVERY_RPC_URL=
DISCOVERY_LOG_RANGE=2000
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- New wallets (public addresses). Any wallet works for the pauser.
DEPLOYER_ADDRESS=
OPERATOR_ADDRESS=
KEEPER_ADDRESS=
ATTESTER_ADDRESS=
PAUSER_ADDRESS=
VALIDATOR_1_ADDRESS=
VALIDATOR_2_ADDRESS=
VALIDATOR_3_ADDRESS=

# --- New wallets (private keys). The deployer key stays on your machine.
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY_1=
VALIDATOR_PRIVATE_KEY_2=
VALIDATOR_PRIVATE_KEY_3=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=

# --- Deploy inputs
# Canonical hash of config/nti.v1.json (printed by mainnet_preflight.py)
INITIAL_CONFIG_HASH=0x07acec1d77949027e6ba95a4ec7b43ce380fb70efd317e79d0f024e4afc8c297
ORACLE_GENESIS_TIMESTAMP=0
# Leave EMPTY: the deploy creates the prelaunch token (pNTI). When the real $NTI launches on Pons, set the
# address below and run SwapTokenMainnet.s.sol.
NTI_TOKEN_ADDRESS=
# Only for SwapTokenMainnet: 1 also freezes the registry so the token can never change again
FREEZE=0
BUYBACK_ADAPTER=
RADAR_MIN_STAKE=
