# Mainnet (Robinhood Chain 4663). On the mainnet VPS this becomes /home/ubuntu/apps/nti-mainnet/.env (mode 600).
# Use brand-new keys. Never reuse a testnet key. Keep this file out of git.
#
# Two files are made from this template:
#   .env.mainnet  on your own machine, used for the deploy scripts (contains the DEPLOYER key)
#   .env          on the mainnet VPS, used by the services (must NOT contain the DEPLOYER key)

# --- Chain and RPC
CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_ID=4663
# One URL in .env.mainnet (forge uses it). On the VPS a comma-separated fallback chain is allowed:
# paid primary, second provider, then https://rpc.mainnet.chain.robinhood.com
RPC_URL_MAINNET=
# Must serve eth_getLogs over INDEXER_BATCH_BLOCKS blocks (the preflight probes it). Blocks are ~0.1s.
INDEXER_RPC_URL=
INDEXER_START_BLOCK=
INDEXER_BATCH_BLOCKS=500
DISCOVERY_RPC_URL=
DISCOVERY_LOG_RANGE=500
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- Separate Supabase project from testnet (tables have no chain_id column)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
# Optional guard: the preflight fails if SUPABASE_URL equals this
TESTNET_SUPABASE_URL=

# --- Role addresses (public), read by DeployMainnet.s.sol and the preflight
DEPLOYER_ADDRESS=
OPERATOR_ADDRESS=
KEEPER_ADDRESS=
ATTESTER_ADDRESS=
# The Safe (at least 2 of 3). It can pause; it cannot change anything else.
PAUSER_ADDRESS=
VALIDATOR_1_ADDRESS=
VALIDATOR_2_ADDRESS=
VALIDATOR_3_ADDRESS=

# --- Private keys. The deployer key is used from your own machine only.
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY_1=
VALIDATOR_PRIVATE_KEY_2=
VALIDATOR_PRIVATE_KEY_3=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=

# --- Deploy inputs
# Canonical hash of config/nti.v1.json (printed by mainnet_preflight.py)
INITIAL_CONFIG_HASH=0x07acec1d77949027e6ba95a4ec7b43ce380fb70efd317e79d0f024e4afc8c297
NTI_CONFIG_PATH=./config/nti.v1.json
ORACLE_GENESIS_TIMESTAMP=0
# Leave empty until the CA exists, then run AttachTokenMainnet.s.sol
NTI_TOKEN_ADDRESS=
# Only for HandoverMainnet.s.sol (the Safe that receives registry ownership)
SAFE_ADDRESS=
RADAR_MIN_STAKE=
GRANT_ROUND_SECONDS=1209600

# --- Services
VALIDATOR_OMISSION_CHECK=1
X_ACCOUNTS_FILE=secrets/x_accounts.json
TWSCRAPE_DB_PATH=data/state/accounts.db
FETCHER_MIN_SUCCESS_RATIO=0.95
FETCHER_RECOVERY_ROUNDS=3
FETCHER_RECOVERY_WAIT_SECONDS=960
FETCHER_RECOVERY_DEADLINE_SECONDS=9000
CLASSIFIER_CONCURRENCY=4
MIMO_API_KEY=
MIMO_API_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro

# --- Web and alerts
SIWE_SESSION_SECRET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
