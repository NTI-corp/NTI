# =====================================================================
# NTI Environment Configuration
# Copy of infra/.env.example — NEVER commit this file.
# =====================================================================

# --- 1. Chain & RPC (Robinhood Chain: 46630 testnet | 4663 mainnet) ---
CHAIN_ID=46630
RPC_URL_TESTNET=https://robinhood-sepolia-rpc.publicnode.com
RPC_URL_MAINNET=https://robinhood-rpc.publicnode.com
ALCHEMY_API_KEY=
EXPLORER_API_KEY=

# --- 2. Supabase (Database & Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- 3. Wallet & Private Keys (Hot wallets: isi ETH gas secukupnya saja) ---
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY_1=
VALIDATOR_PRIVATE_KEY_2=
VALIDATOR_PRIVATE_KEY_3=
KEEPER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
# Public address multisig Safe 2/3 atau wallet pauser tim (BUKAN private key)
PAUSER_ADDRESS=

# --- 4. LLM Classifier (Gemini Flash-Lite utama, MiMo-V2.5 cadangan on 429) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
MIMO_API_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5

# --- 5. X Data Fetcher (9 akun primary + 3 akun validator pool) ---
# Di VPS ganti ke: /home/ubuntu/apps/nti/secrets/x_accounts.json
X_ACCOUNTS_FILE=./secrets/x_accounts.json
# Opsional: fallback berbayar (dibatasi hard cap bulanan) & pembanding X API sekali pakai
TWITTERAPI_IO_KEY=
X_OFFICIAL_BEARER_TOKEN=
MONTHLY_DATA_BUDGET_USD=50

# --- 6. Arweave / IPFS (Canonical Delta Dataset Storage) ---
ARWEAVE_WALLET_FILE=./secrets/arweave-wallet.json
TURBO_TOKEN=
IPFS_API_URL=

# --- 7. Web, SIWE & WalletConnect ---
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Generate 32-byte hex acak untuk cookie sesi SIWE
SIWE_SESSION_SECRET=

# --- 8. Monitoring & Alert (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 9. Protocol & Indexer Defaults (sudah siap pakai) ---
NTI_CONFIG_PATH=./config/nti.v1.json
# 100,000 NTI in wei (rekalibrasi setelah $NTI live)
RADAR_MIN_STAKE=100000000000000000000000
INDEXER_POLL_MS=5000
INDEXER_BATCH_BLOCKS=2000
INDEXER_REORG_BUFFER=50
